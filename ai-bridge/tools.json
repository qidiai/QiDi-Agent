[
  {
    "name": "openclaw",
    "displayName": "OpenClaw",
    "description": "OpenClaw AI Agent (agnes-2.0-flash)",
    "transport": "cli",
    "command": "openclaw",
    "args": [
      "agent",
      "--agent",
      "main",
      "--session-key",
      "{{sessionId}}",
      "--json",
      "--message-file",
      "{{messageFile}}"
    ],
    "inputMode": "message-file",
    "outputMode": "stdout-json",
    "parse": {
      "textPath": "payloads[0].text || result.payloads[0].text || result.meta.finalAssistantVisibleText || result.meta.finalAssistantRawText || reply || content || message",
      "usagePath": "result.meta.agentMeta.usage || usage"
    },
    "timeout": 120000
  },
  {
    "name": "atom-code",
    "displayName": "AtomCode",
    "description": "AtomCode AI (GLM)",
    "transport": "cli",
    "command": "atomcode",
    "commandPaths": [
      "{{LOCALAPPDATA}}/AtomCode/atomcode.exe"
    ],
    "args": [
      "--prompt",
      "{{task}}",
      "--dir",
      "{{workspaceDir}}"
    ],
    "inputMode": "arg",
    "outputMode": "stdout-text",
    "timeout": 1800000
  },
  {
    "name": "claude-code",
    "displayName": "Claude Code",
    "description": "Claude Code CLI",
    "transport": "cli",
    "command": "claude",
    "args": [
      "-p"
    ],
    "inputMode": "stdin",
    "outputMode": "stdout-text",
    "timeout": 300000
  },
  {
    "name": "agnes-mcp",
    "displayName": "Agnes MCP",
    "description": "Route task to Agnes (top-level orchestrator) - no external process",
    "transport": "routing-marker"
  },
  {
    "name": "mimo-code",
    "displayName": "Mimo Code",
    "description": "Mimo Code CLI (mimo run)",
    "transport": "cli",
    "command": "mimo",
    "args": [
      "run",
      "{{task}}"
    ],
    "inputMode": "arg",
    "outputMode": "stdout-text",
    "timeout": 120000
  },
  {
    "name": "qoder",
    "displayName": "Qoder",
    "description": "Qoder CLI (qodercli -p)",
    "transport": "cli",
    "command": "qodercli",
    "args": [
      "-p",
      "{{task}}"
    ],
    "inputMode": "arg",
    "outputMode": "stdout-text",
    "timeout": 120000
  },
  {
    "name": "workbuddy",
    "displayName": "WorkBuddy",
    "description": "WorkBuddy Code CLI (codebuddy -p)",
    "transport": "cli",
    "command": "codebuddy",
    "args": [
      "-p",
      "{{task}}"
    ],
    "inputMode": "arg",
    "outputMode": "stdout-text",
    "timeout": 120000
  },
  {
    "name": "codely",
    "displayName": "Codely",
    "description": "Codely CLI (Tuanjie Cowork, default GLM-5.3)",
    "transport": "cli",
    "command": "codely",
    "commandPaths": [
      "{{LOCALAPPDATA}}/Programs/Tuanjie Cowork/cli/bin/win32-x64/codely.exe"
    ],
    "args": [
      "-y",
      "-p",
      "{{task}}"
    ],
    "inputMode": "arg",
    "outputMode": "stdout-text",
    "timeout": 1800000
  },
  {
    "name": "codely-k3",
    "displayName": "Codely K3",
    "description": "Codely CLI (KIMI-K3)",
    "transport": "cli",
    "command": "codely",
    "commandPaths": [
      "{{LOCALAPPDATA}}/Programs/Tuanjie Cowork/cli/bin/win32-x64/codely.exe"
    ],
    "args": [
      "-y",
      "--model",
      "KIMI-K3",
      "-p",
      "{{task}}"
    ],
    "inputMode": "arg",
    "outputMode": "stdout-text",
    "timeout": 1800000
  },
  {
    "name": "opencode",
    "displayName": "OpenCode",
    "description": "OpenCode CLI (opencode run, opencode-go/step-5-preview-free 1M, --auto)",
    "transport": "cli",
    "command": "opencode",
    "args": [
      "run",
      "-m",
      "opencode-go/step-5-preview-free",
      "--auto"
    ],
    "inputMode": "stdin",
    "outputMode": "stdout-text",
    "timeout": 600000
  },
  {
    "name": "opencode-k3",
    "displayName": "OpenCode K3",
    "description": "OpenCode CLI (opencode-go/kimi-k3, zen free, --auto)",
    "transport": "cli",
    "command": "opencode",
    "args": [
      "run",
      "-m",
      "opencode-go/kimi-k3",
      "--auto"
    ],
    "inputMode": "stdin",
    "outputMode": "stdout-text",
    "timeout": 600000
  },
  {
    "name": "opencode-flash",
    "displayName": "OpenCode Flash",
    "description": "OpenCode CLI (opencode-go/deepseek-v4.1-flash, zen free, --auto)",
    "transport": "cli",
    "command": "opencode",
    "args": [
      "run",
      "-m",
      "opencode-go/deepseek-v4.1-flash",
      "--auto"
    ],
    "inputMode": "stdin",
    "outputMode": "stdout-text",
    "timeout": 600000
  }
]